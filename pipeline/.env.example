# Pipeline environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# Django base URL (no trailing slash)
DJANGO_API_URL=https://codeutsava.nitrr.ac.in

# Django admin credentials (superuser account)
DJANGO_ADMIN_USER=
DJANGO_ADMIN_PASS=

# Google Sheet spreadsheet ID (from the URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=

# Path to the Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Year to tag members with (must match the Django model year field)
TEAM_YEAR=2026
